{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pliegors.dev/schemas/pliego.next-fixture-manifest.schema.json",
  "title": "PliegoRS Next fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "authority",
    "policy",
    "measurementCases",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "const": "https://pliegors.dev/schemas/pliego.next-fixture-manifest.schema.json"
    },
    "contract": {
      "const": "dev.pliegors.next-fixture-manifest/v1"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "measurementCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/measurementCase"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releasedTag",
        "releasedRevision",
        "preNextRevision"
      ],
      "properties": {
        "releasedTag": {
          "const": "v0.4.0-beta.1"
        },
        "releasedRevision": {
          "$ref": "#/$defs/revision"
        },
        "preNextRevision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmupRuns",
        "measuredRuns",
        "percentileMethod",
        "percentiles",
        "outlierPolicy",
        "bottlenecks"
      ],
      "properties": {
        "warmupRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "measuredRuns": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30
        },
        "percentileMethod": {
          "const": "nearest-rank"
        },
        "percentiles": {
          "type": "array",
          "prefixItems": [
            { "const": "p50" },
            { "const": "p95" },
            { "const": "p99" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "outlierPolicy": {
          "const": "none"
        },
        "bottlenecks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statistic", "unit", "count", "candidateCaseIds"],
          "properties": {
            "statistic": {
              "const": "p95"
            },
            "unit": {
              "const": "milliseconds"
            },
            "count": {
              "const": 3
            },
            "candidateCaseIds": {
              "type": "array",
              "minItems": 3,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "measurementCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "unit", "collector", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "build",
            "development",
            "browser",
            "memory",
            "lifecycle",
            "artifacts",
            "cache",
            "hmr"
          ]
        },
        "unit": {
          "enum": ["milliseconds", "bytes", "count", "ratio"]
        },
        "collector": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {
          "const": "sha256-tree-v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "notApplicable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "reasonCode", "explanation"],
      "properties": {
        "caseId": {
          "$ref": "#/$defs/identifier"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "descriptor",
        "workload",
        "objective",
        "sourceIdentity",
        "notApplicable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "root": {
          "$ref": "#/$defs/repositoryPath"
        },
        "descriptor": {
          "$ref": "#/$defs/repositoryPath"
        },
        "workload": {
          "$ref": "#/$defs/identifier"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sourceIdentity": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "notApplicable": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/notApplicable"
          }
        }
      }
    }
  }
}
